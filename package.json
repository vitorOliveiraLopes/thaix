{
  "name": "thaix",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo do ThaixSkill: apps/api (Next, Vercel), apps/mobile (Expo: Android e web, fora dos workspaces) e packages/core (regras).",
  "workspaces": [
    "packages/*",
    "apps/api"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @thaix/api",
    "build:api": "npm run build -w @thaix/api",
    "test": "vitest run",
    "typecheck": "npm run typecheck -w @thaix/core -w @thaix/api"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
