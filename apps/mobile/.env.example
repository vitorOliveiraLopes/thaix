# Copie para .env.local e preencha com os valores do Supabase (Project Settings → API).
# Só a chave pública (anon/publishable) vai no app. Nunca coloque a service role aqui.
EXPO_PUBLIC_SUPABASE_URL=https://avqkvhkfilrnbytrjbit.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# API do ThaixSkill (rotas Next na Vercel): conclusão de treino e chat.
EXPO_PUBLIC_API_URL=https://thaix.vercel.app

# Monitoramento de erros (Sentry, projeto "React Native"). Opcional: sem ele
# o app funciona igual, só não reporta erros. O DSN é público por natureza.
EXPO_PUBLIC_SENTRY_DSN=
