# Copie para .env.local e preencha com os valores do Supabase (Project Settings → API).
# Tudo com EXPO_PUBLIC_ vai dentro do app e do site: só a chave pública (anon/publishable).
# Nunca coloque a service role aqui.
EXPO_PUBLIC_SUPABASE_URL=https://avqkvhkfilrnbytrjbit.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Endereço do site, que também é o da API (src/app/api). O Android chama a API
# aqui, e os links de e-mail (nova senha, confirmação de cadastro) abrem aqui.
# Na web não é usado: o site usa o próprio endereço.
EXPO_PUBLIC_SITE_URL=https://thaix-web-mobile.vercel.app

# Monitoramento de erros do app (Sentry, projeto "React Native"). Opcional.
EXPO_PUBLIC_SENTRY_DSN=

# ─── Só servidor (rotas de API). Sem EXPO_PUBLIC_: nunca vão para o app. ────────
# Necessárias para testar o coach localmente com "npx expo start".
ANTHROPIC_API_KEY=
COACH_MODEL=
COACH_DAILY_LIMIT=
SENTRY_DSN=
